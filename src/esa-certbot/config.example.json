{
  "provider": "esa",
  "agree_tos": false,
  "email": "cert-operator@example.com",
  "acme_directory": "https://acme-staging-v02.api.letsencrypt.org/directory",
  "renew_before_days": 30,
  "dns_timeout": 180,
  "dns_stable_seconds": 300,
  "regions": ["cn-shanghai"],
  "targets": {
    "api": {
      "domain": "api.example.com",
      "zone": "example.com",
      "site_id": 123456789,
      "esa_region": "cn-hangzhou",
      "region": "cn-shanghai",
      "nameservers": ["ns1.example.com", "ns2.example.com"],
      "tls_connect_host": "fc-origin.example.com"
    }
  }
}
